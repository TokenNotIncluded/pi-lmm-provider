{
  "name": "@tokennotincluded/pi-lmm-provider",
  "version": "0.1.0-alpha.2",
  "description": "LMM OAuth provider for Pi's native model selector (integration-gated preview)",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "TokenNotIncluded",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokenNotIncluded/pi-lmm-provider.git"
  },
  "homepage": "https://github.com/TokenNotIncluded/pi-lmm-provider#readme",
  "bugs": {
    "url": "https://github.com/TokenNotIncluded/pi-lmm-provider/issues"
  },
  "keywords": [
    "pi-package",
    "oauth",
    "lmm"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "lmm-pi-provider": "./scripts/install.mjs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src/*.ts",
    "scripts/install.mjs",
    "README.md",
    "CONTRACT_GAPS.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.86.1 <0.88.0",
    "@earendil-works/pi-coding-agent": ">=0.86.1 <0.88.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "26.1.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts test/*.test.mjs",
    "typecheck": "tsgo --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "test:pi": "node scripts/test-pi.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "typebox": "^1.3.30"
  }
}
