{
  "name": "@tokennotincluded/pi-lmm-provider",
  "version": "0.1.0-alpha.5",
  "description": "LMM OAuth provider for Pi's native model selector (integration-gated preview)",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "TokenNotIncluded",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokenNotIncluded/pi-lmm-provider.git"
  },
  "homepage": "https://github.com/TokenNotIncluded/pi-lmm-provider#readme",
  "bugs": {
    "url": "https://github.com/TokenNotIncluded/pi-lmm-provider/issues"
  },
  "keywords": [
    "pi-package",
    "oauth",
    "lmm"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "lmm-pi-provider": "scripts/install.mjs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "assets",
    "src/*.ts",
    "src/models-dev.json",
    "src/models-dev.LICENSE",
    "scripts/install.mjs",
    "README.md",
    "CONTRACT_GAPS.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.86.1",
    "@earendil-works/pi-coding-agent": ">=0.86.1",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "26.1.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "pi-ask-user": "0.16.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts test/*.test.mjs",
    "typecheck": "tsgo --noEmit",
    "metadata:update": "node --experimental-strip-types scripts/update-model-metadata.mjs",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "test:pi": "node scripts/test-pi.mjs",
    "test:remote": "node --experimental-strip-types test/remote-sdk.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.12.2"
    }
  }
}
